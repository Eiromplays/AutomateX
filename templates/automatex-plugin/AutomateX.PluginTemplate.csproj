<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host provides the SDK at runtime, so exclude its runtime asset (never ship a private copy).
         Package the plugin as the flat `dotnet publish` output zipped with plugin.json at the root. -->
    <PackageReference Include="AutomateX.Plugin.Sdk" Version="1.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
