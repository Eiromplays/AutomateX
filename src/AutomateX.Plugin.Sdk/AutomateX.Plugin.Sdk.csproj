<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>AutomateX.Plugin.Sdk</PackageId>
    <Title>AutomateX Plugin SDK</Title>
    <Description>SDK for building AutomateX plugins. Implement IAction, decorate with [Action], drop the assembly in the plugins folder.</Description>
    <Authors>Eiromplays</Authors>
    <Company>AutomateX</Company>
    <Product>AutomateX</Product>
    <PackageTags>automatex;plugin;automation;workflow;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Eiromplays/AutomateX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Eiromplays/AutomateX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- Version is supplied by the sdk-v* release tag (publish-sdk.yml); 0.0.0 for local packs. -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
