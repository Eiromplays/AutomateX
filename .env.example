# Copy to .env next to docker-compose.prod.yml and fill in. Keep .env out of git.

# Postgres password (any strong value; the DB is LAN/Tailscale-only).
POSTGRES_PASSWORD=change-me

# AES key for connection secrets. Generate once and never change it:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Public https origin AutomateX is reached at — the Tailscale Serve hostname.
# Used to build webhook URLs and OIDC redirect URIs.
PUBLIC_BASE_URL=https://automatex.your-tailnet.ts.net

# OIDC provider (Entra ID, Authentik, Keycloak, Auth0, …).
# Register the redirect URI  <PUBLIC_BASE_URL>/signin-oidc
# and post-logout URI        <PUBLIC_BASE_URL>/signout-callback-oidc  at the provider.
OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Allow uploading plugins through the UI/API. Uploaded plugins run in-process with full host trust,
# so leave false unless you're actively adding one.
ALLOW_PLUGIN_UPLOAD=false

# Opt-in automatic plugin updates: how often to check catalog-installed plugins for a newer compatible,
# same-major version from a VERIFIED source (a .NET TimeSpan, e.g. 01:00:00 = hourly). Empty = off. Also
# requires ALLOW_PLUGIN_UPLOAD=true. Enable by uncommenting the mapping in docker-compose.prod.yml.
PLUGIN_AUTO_UPDATE_INTERVAL=

# SSRF guard: block http.request, webhook.send, and plugin HTTP (actions/triggers/connection tests)
# to private/loopback/link-local (incl. cloud metadata) targets. As of v4.7 it reaches across the
# out-of-process plugin boundary too. Off by default so a local LLM / LAN services work; turn on for
# internet-exposed instances that don't legitimately call internal hosts.
BLOCK_PRIVATE_NETWORK_REQUESTS=false

# Escape hatch for the guard above (only meaningful when it's ON): comma-separated hostnames and/or
# CIDRs that stay reachable — e.g. a LAN webhook or self-hosted API — while every other private target
# stays blocked. Widens only, never narrows; empty keeps the guard all-or-nothing (v4.7 behaviour).
# Example: EGRESS_ALLOWLIST=metrics.lan,10.8.0.0/24,fd00::/8
EGRESS_ALLOWLIST=

# --- Clustering / high availability (v5.0) — leave both at the defaults for a normal single-node deploy ---
# Solo (default) = single node: fast in-process queues, instant execution — same as before v5.0.
# Balanced = multiple nodes: leader election runs the singleton workers (cron, plugin triggers, sweepers)
# on exactly one node, and executions distribute over a shared Postgres queue. Only set Balanced when you
# actually run more than one api replica — Solo with replicas double-fires triggers. See deploy-homelab.md.
DURABILITY_MODE=Solo
# SignalR backplane so live UI updates reach clients on every node. Empty = in-process (single node).
# For HA, start the redis service (`--profile ha`) and set this to redis:6379.
REDIS_CONNECTION=
